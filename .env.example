
# Application
NODE_ENV=development

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_PORT=3001

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=apulse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=apulse

# MinIO
MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-11-09T00-00-00Z
MINIO_CLIENT_IMAGE=quay.io/minio/mc:latest

MINIO_ROOT_USER=apulse_admin
MINIO_ROOT_PASSWORD=your-strong-password

MINIO_BUCKET=apulse-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
